{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM"],
    "types": ["webmcp-types"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".test-dist"
  },
  "include": [
    "src/types.ts",
    "src/data/**/*.ts",
    "src/domain/**/*.ts",
    "src/state/**/*.ts",
    "src/webmcp/**/*.ts"
  ]
}
