{
  "name": "webmcp-seating-repair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A shared seating chart that humans and browser agents can repair together through WebMCP.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "webmcp",
    "human-agent-collaboration",
    "seating-chart"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
